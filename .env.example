# ─── LLM provider ────────────────────────────────────────────────────────────
# The agents read these via app/config.py. NEVER commit real keys.
# Provider abstraction: "groq" (default) or "openai".
LLM_PROVIDER=groq

# Model id for the chosen provider.
#   groq   -> openai/gpt-oss-120b   (recommended; llama-3.3-70b-versatile is decommissioned)
#   openai -> gpt-4o-mini, gpt-4o, ...
LLM_MODEL=openai/gpt-oss-120b

LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
# LLM_MAX_TOKENS=

# Provide the key for your chosen provider. If none is set, the app runs in a
# fully-functional deterministic HEURISTIC mode (no fabricated LLM output).
GROQ_API_KEY=
OPENAI_API_KEY=
# Generic override that takes precedence over the provider-specific keys above.
LLM_API_KEY=

# ─── Optional: LangSmith tracing ─────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=agentic-automl

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list (or JSON array) of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ─── Storage (defaults resolve inside backend/) ──────────────────────────────
# DATA_DIR=./data
# ARTIFACTS_DIR=./artifacts

# ─── Upload / dataset limits ─────────────────────────────────────────────────
MAX_UPLOAD_MB=50
MAX_ROWS=200000
MAX_COLUMNS=2000

# ─── ML defaults ─────────────────────────────────────────────────────────────
RANDOM_STATE=42
TEST_SIZE=0.2
CV_FOLDS=5
MAX_TRAINING_ROWS=50000

# ─── Frontend ────────────────────────────────────────────────────────────────
# Base URL the React app uses to reach the API (Vite env var).
VITE_API_BASE_URL=http://localhost:8000
